# Gmail SMTP (use a Google App Password, not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-account@gmail.com
SMTP_PASSWORD=your-16-character-app-password
SMTP_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-account@gmail.com
MAIL_FROM_NAME=Smart Attendance System

# Optional application URL used in reset emails
APP_URL=http://localhost/AttendanceSystem
